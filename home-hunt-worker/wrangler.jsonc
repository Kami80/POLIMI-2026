{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polimi-home-hunt-importer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://kami80.github.io,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500",
    "ENABLE_READER_FALLBACK": "true"
  }
}
